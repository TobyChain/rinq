{
  "version": "1",
  "description": "Rinq: surface TraeX turn completion / approvals on the watch",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/rinq hook-traex",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/rinq hook-traex",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/rinq hook-traex",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
